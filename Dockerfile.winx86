# ffmpeg for videos

# -------------------------------------------------
# Build FFmpeg (armhf) from git with VQA3 support
# -------------------------------------------------
ARG FFMPEG_GIT_REF=n7.1.1
# You can switch to "master" if you want latest:
# ARG FFMPEG_GIT_REF=master


ARG FFMPEG_PREFIX=/opt/ffmpeg-win32
ENV FFMPEG_PREFIX=${FFMPEG_PREFIX}

WORKDIR /build


RUN git clone https://git.ffmpeg.org/ffmpeg.git /build/ffmpeg && \
    cd /build/ffmpeg && \
    git checkout ${FFMPEG_GIT_REF}

ENV CC="ccache i686-w64-mingw32-gcc"
ENV CXX="ccache i686-w64-mingw32-g++"
ENV AR="i686-w64-mingw32-ar"
ENV RANLIB="i686-w64-mingw32-ranlib"
ENV STRIP="i686-w64-mingw32-strip"
ENV WINDRES="i686-w64-mingw32-windres"

RUN --mount=type=cache,target=/root/.ccache \
    cd /build/ffmpeg && \
    ./configure \
      --prefix=${FFMPEG_PREFIX} \
      --arch=x86 \
      --cpu=i686 \
      --target-os=mingw32 \
      --cross-prefix=i686-w64-mingw32- \
      --enable-cross-compile \
      --enable-shared \
      --disable-static \
      --disable-programs \
      --disable-doc \
      --disable-debug \
      --enable-pic \
      --disable-openssl --disable-gnutls --disable-bzlib --disable-zlib

RUN --mount=type=cache,target=/root/.ccache \
    cd /build/ffmpeg && make -j"$(nproc)" \
    && make install

RUN ls -l /opt/ffmpeg-win32/bin/av*.dll || true && \
    ls -l /opt/ffmpeg-win32/lib/pkgconfig/libavformat.pc || true

#RUN exit 1

# back to nox

# -------------------------------------------------
# Build SDL2 for Windows (MinGW i686) so <SDL2/SDL.h> exists
# -------------------------------------------------
ARG SDL2_VERSION=release-2.30.11
ARG SDL2_PREFIX=/opt/sdl2-win32
ENV SDL2_PREFIX=${SDL2_PREFIX}

RUN git clone https://github.com/libsdl-org/SDL.git /build/SDL && \
    cd /build/SDL && \
    git checkout ${SDL2_VERSION}

RUN --mount=type=cache,target=/root/.ccache \
    cmake -S /build/SDL -B /build/SDL/build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=${SDL2_PREFIX} \
      -DCMAKE_SYSTEM_NAME=Windows \
      -DCMAKE_C_COMPILER=i686-w64-mingw32-gcc \
      -DCMAKE_CXX_COMPILER=i686-w64-mingw32-g++ \
      -DCMAKE_RC_COMPILER=i686-w64-mingw32-windres \
      -DSDL_SHARED=ON \
      -DSDL_STATIC=OFF \
      -DSDL_TEST=OFF && \
    cmake --build /build/SDL/build -j"$(nproc)" && \
    cmake --install /build/SDL/build


RUN ls -l ${SDL2_PREFIX}/include/SDL2/SDL.h && \
    (ls -l ${SDL2_PREFIX}/lib/pkgconfig/sdl2.pc || true)

ENV PKG_CONFIG_PATH=/opt/ffmpeg-win32/lib/pkgconfig:/opt/sdl2-win32/lib/pkgconfig
ENV PKG_CONFIG_LIBDIR=/opt/ffmpeg-win32/lib/pkgconfig:/opt/sdl2-win32/lib/pkgconfig
ENV PKG_CONFIG_SYSROOT_DIR=

# -------------------------------------------------
# OpenAL for Windows (prebuilt binaries)  ✅ option B
# -------------------------------------------------
ARG OPENAL_VERSION=1.22.2
ARG OPENAL_PREFIX=/opt/openal-win32
ENV OPENAL_PREFIX=${OPENAL_PREFIX}

RUN mkdir -p ${OPENAL_PREFIX} /tmp/openal && \
    wget -q -O /tmp/openal/openal.zip https://openal-soft.org/openal-binaries/openal-soft-${OPENAL_VERSION}-bin.zip && \
    unzip -q /tmp/openal/openal.zip -d /tmp/openal && \
    echo "[openal] extracted:" && \
    find /tmp/openal -maxdepth 3 -type d -print

# Typical layout inside the zip:
#   openal-soft-<ver>/
#     include/AL/...
#     bin/Win32/soft_oal.dll
#     libs/Win32/libOpenAL32.a  (and/or OpenAL32.lib)

RUN set -eux; \
    OA_DIR="$(find /tmp/openal -maxdepth 2 -type d -name 'openal-soft-*' | head -n1)"; \
    echo "[openal] OA_DIR=$OA_DIR"; \
    mkdir -p "${OPENAL_PREFIX}/include" "${OPENAL_PREFIX}/bin" "${OPENAL_PREFIX}/lib"; \
    cp -av "${OA_DIR}/include/AL" "${OPENAL_PREFIX}/include/"; \
    \
    # MinGW import libs (prefer Win32)
    if [ -d "${OA_DIR}/libs/Win32" ]; then \
      cp -av "${OA_DIR}/libs/Win32/"* "${OPENAL_PREFIX}/lib/" || true; \
    elif [ -d "${OA_DIR}/libs" ]; then \
      cp -av "${OA_DIR}/libs/"* "${OPENAL_PREFIX}/lib/" || true; \
    fi; \
    \
    # DLL: rename soft_oal.dll -> OpenAL32.dll for conventional loading
    if [ -f "${OA_DIR}/bin/Win32/soft_oal.dll" ]; then \
      cp -av "${OA_DIR}/bin/Win32/soft_oal.dll" "${OPENAL_PREFIX}/bin/OpenAL32.dll"; \
    elif [ -f "${OA_DIR}/bin/soft_oal.dll" ]; then \
      cp -av "${OA_DIR}/bin/soft_oal.dll" "${OPENAL_PREFIX}/bin/OpenAL32.dll"; \
    fi; \
    \
    ls -la "${OPENAL_PREFIX}/include/AL" || true; \
    ls -la "${OPENAL_PREFIX}/lib" || true; \
    ls -la "${OPENAL_PREFIX}/bin" || true


ENV PKG_CONFIG_PATH=/opt/ffmpeg-win32/lib/pkgconfig:/opt/sdl2-win32/lib/pkgconfig:/opt/openal-win32/lib/pkgconfig
ENV PKG_CONFIG_LIBDIR=/opt/ffmpeg-win32/lib/pkgconfig:/opt/sdl2-win32/lib/pkgconfig:/opt/openal-win32/lib/pkgconfig

# -------------------------------------------------
# Build GLEW for Windows (MinGW i686) so modern GL symbols link
# -------------------------------------------------
ARG GLEW_PREFIX=/opt/glew-win32
ENV GLEW_PREFIX=${GLEW_PREFIX}

# Use a release/snapshot archive (contains generated src/ + include/)
# (Git tags often don't ship the generated files required by CMake.)
ARG GLEW_TARBALL_URL=https://sourceforge.net/projects/glew/files/glew/2.1.0/glew-2.1.0.tgz/download

RUN set -eux; \
    mkdir -p /tmp/glew && cd /tmp/glew; \
    wget -q -O glew.tgz "${GLEW_TARBALL_URL}"; \
    tar -xzf glew.tgz; \
    GDIR="$(find . -maxdepth 1 -type d -name 'glew-*' | head -n1)"; \
    test -n "$GDIR"; \
    mv "$GDIR" /build/glew; \
    \
    cmake -S /build/glew/build/cmake -B /build/glew/build-win32 \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_SYSTEM_NAME=Windows \
      -DCMAKE_C_COMPILER=i686-w64-mingw32-gcc \
      -DCMAKE_RC_COMPILER=i686-w64-mingw32-windres \
      -DCMAKE_INSTALL_PREFIX="${GLEW_PREFIX}" \
      -DBUILD_SHARED_LIBS=ON; \
    cmake --build /build/glew/build-win32 -j"$(nproc)"; \
    cmake --install /build/glew/build-win32; \
    \
    test -f "${GLEW_PREFIX}/include/GL/glew.h"; \
    ls -la "${GLEW_PREFIX}/include/GL/glew.h"; \
    ls -la "${GLEW_PREFIX}/lib" || true; \
    ls -la "${GLEW_PREFIX}/bin" || true



RUN test -f /opt/glew-win32/include/GL/glew.h && echo "GLEW header OK"

# -------------------------------------------------
# Fetch sources
# -------------------------------------------------
#RUN git clone https://github.com/neuromancer/nox-decomp.git
COPY . /build/nox-decomp

# -------------------------------------------------
# Patches BEFORE configure/build
# -------------------------------------------------


RUN --mount=type=cache,target=/root/.ccache \
    mkdir -p /build/nox-decomp/build && \
    cd /build/nox-decomp/build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Debug \
      -DFFMPEG_PREFIX=/opt/ffmpeg-win32 \
      -DCMAKE_PREFIX_PATH="/opt/sdl2-win32;/opt/openal-win32;/opt/glew-win32;/opt/ffmpeg-win32" \
      -DOPENAL_INCLUDE_DIR=/opt/openal-win32/include \
      -DOPENAL_LIBRARY=/opt/openal-win32/lib/libOpenAL32.dll.a \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
      -DCMAKE_SYSTEM_NAME=Windows \
      -DCMAKE_C_COMPILER=i686-w64-mingw32-gcc \
      -DCMAKE_CXX_COMPILER=i686-w64-mingw32-g++ \
      -DCMAKE_RC_COMPILER=i686-w64-mingw32-windres \
      -DUSE_SDL=ON \
      -DUSE_DIRECTX=OFF \
      -DCMAKE_C_FLAGS="-I/opt/sdl2-win32/include -I/opt/openal-win32/include -I/opt/glew-win32/include -U_FORTIFY_SOURCE -fno-strict-aliasing -fsigned-char -O0 -fno-tree-vectorize -fno-aggressive-loop-optimizations" \
      -DCMAKE_CXX_FLAGS="-I/opt/sdl2-win32/include -I/opt/openal-win32/include -I/opt/glew-win32/include -fno-strict-aliasing -fsigned-char -O0" \
      -DCMAKE_EXE_LINKER_FLAGS="-L/opt/sdl2-win32/lib -L/opt/openal-win32/lib -L/opt/glew-win32/lib -L/opt/ffmpeg-win32/lib"




#COPY draw.c /build/nox-decomp/src/draw.c
#COPY win.c /build/nox-decomp/src/win.c
#COPY compat.c /build/nox-decomp/src/compat.c
#COPY string.c /build/nox-decomp/src/string.c
#COPY GAME4.c /build/nox-decomp/src/GAME4.c

RUN --mount=type=cache,target=/root/.ccache \
    cd /build/nox-decomp/build && \
    cmake --build . -j $(nproc)

RUN --mount=type=cache,target=/root/.ccache \
    set -eux; \
    cd /build/nox-decomp/dist-scripts/winlaunch; \
    i686-w64-mingw32-gcc -O2 -s -municode \
      -o /build/nox-decomp/build/src/launch-nox-decomp.exe winlaunch.c \
      -lcomdlg32 -lshell32 -lole32 -ladvapi32 -lgdi32 -luser32 -mwindows

RUN mkdir -p /build/nox-decomp/build/src/lib && \
    cp -av ${FFMPEG_PREFIX}/bin/av*.dll /build/nox-decomp/build/src/lib/ || true

RUN mkdir -p /build/nox-decomp/build/src/lib && \
    cp -av ${SDL2_PREFIX}/bin/SDL2.dll /build/nox-decomp/build/src/lib/ || true

RUN mkdir -p /build/nox-decomp/build/src/lib && \
    cp -av ${OPENAL_PREFIX}/bin/OpenAL32.dll /build/nox-decomp/build/src/lib/ || true


# -------------------------------------------------
# Verify output
# -------------------------------------------------
RUN find /build/nox-decomp/build/
RUN file /build/nox-decomp/build/src/out* || true

#RUN nm /build/nox-decomp/build/src/out | grep -E 'sub_4F4E50($|__)'
#RUN nm /build/nox-decomp/build/src/out | grep 'sub_50A5C0'


# -------------------------------------------------
# Bundle: create /build/nox-decomp/build/src/noxd.win32 with exe + DLLs
# -------------------------------------------------
RUN set -eux; \
    OUTDIR=/build/nox-decomp/build/src/noxd.win32; \
    mkdir -p "$OUTDIR"; \
    cp -av /build/nox-decomp/build/src/out.exe "$OUTDIR/"; \
    \
    # game/vendor DLLs
    cp -av /build/nox-decomp/build/src/lib/. "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/ffmpeg-win32/bin/av*.dll "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/ffmpeg-win32/bin/sw*.dll      "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/ffmpeg-win32/bin/postproc*.dll "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/sdl2-win32/bin/SDL2.dll "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/openal-win32/bin/OpenAL32.dll "$OUTDIR/" 2>/dev/null || true; \
    cp -av /opt/glew-win32/bin/*.dll "$OUTDIR/" 2>/dev/null || true; \
    \
    # toolchain runtime DLLs (MinGW i686)
    ( test -f /usr/i686-w64-mingw32/lib/libwinpthread-1.dll && cp -av /usr/i686-w64-mingw32/lib/libwinpthread-1.dll "$OUTDIR/" ) \
      || ( f="$(find /usr -type f -name 'libwinpthread-1.dll' | grep -E '/i686-w64-mingw32/' | head -n1)"; test -n "$f" && cp -av "$f" "$OUTDIR/" ) \
      || true; \
    \
    ( f="$(find /usr/lib/gcc -type f -name 'libgcc_s_sjlj-1.dll' | grep -E '/i686-w64-mingw32/' | head -n1)"; test -n "$f" && cp -av "$f" "$OUTDIR/" ) || true; \
    ( f="$(find /usr/lib/gcc -type f -name 'libstdc++-6.dll'   | grep -E '/i686-w64-mingw32/' | head -n1)"; test -n "$f" && cp -av "$f" "$OUTDIR/" ) || true; \
    \
    ls -la "$OUTDIR"

