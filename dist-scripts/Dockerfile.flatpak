# syntax=docker/dockerfile:1.6
FROM ubuntu:latest

ARG DEBIAN_FRONTEND=noninteractive

ARG RUNTIME_VER=24.08
ARG GL_VER=1.4
ARG ARCH=x86_64

ENV FLATPAK_SYSTEM_DIR=/var/lib/flatpak

# ---- Base deps + Flatpak tooling ----
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      xz-utils \
      bzip2 \
      zstd \
      git \
      python3 \
      file \
      sudo \
      flatpak \
      ostree \
      bubblewrap \
      fuse3 \
    && rm -rf /var/lib/apt/lists/* \
    # Your script calls sudo; in a container we run as root, so make sudo a no-op wrapper.
    && printf '#!/bin/sh\nexec "$@"\n' > /usr/local/bin/sudo \
    && chmod +x /usr/local/bin/sudo

# ---- Add Flathub (system) ----
RUN flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# ---- Pre-install runtimes/SDK/extensions (cache-heavy layer) ----
RUN flatpak install -y --system --noninteractive --no-related --arch="${ARCH}" flathub \
      "org.freedesktop.Platform//${RUNTIME_VER}" \
      "org.freedesktop.Sdk//${RUNTIME_VER}" \
      "org.freedesktop.Platform.Compat.i386//${RUNTIME_VER}" \
    && flatpak install -y --system --noninteractive --no-related --arch="${ARCH}" flathub \
      "org.freedesktop.Platform.GL32.default//${RUNTIME_VER}" || true

# Optional: reduce size
RUN flatpak uninstall -y --system --unused || true

WORKDIR /work

# ---- Copy only the files your script uses (including optional ones) ----
COPY ubuntu-buildflatpak.sh /work/ubuntu-buildflatpak.sh
COPY start.sh              /work/start.sh
COPY noxd.i386             /work/noxd.i386
COPY steam/                /work/steam/
COPY ffmpeg.i386/          /work/ffmpeg.i386/

# Optional files (you said they will exist)
COPY io.github.sookyboo.NoxDecomp.png /work/io.github.sookyboo.NoxDecomp.png
COPY gptokeyb2.x86_64                 /work/gptokeyb2.x86_64
COPY nox.cfg                          /work/nox.cfg
COPY nox.gptk2.ini                    /work/nox.gptk2.ini

RUN chmod +x /work/ubuntu-buildflatpak.sh

#ENV APP_NAME=NoxDecomp \
#    APP_ID=io.github.sookyboo.NoxDecomp \
#    RUNTIME_VER=24.08 \
#    GL_VER=1.4 \
#    ARCH=x86_64 \
#    BUILD_DIR=build-dir \
#    REPO_DIR=repo \
#    OUT_DIR=out \
#    LOCAL_REMOTE_NAME=noxdecomp-local

CMD ["/work/ubuntu-buildflatpak.sh"]
